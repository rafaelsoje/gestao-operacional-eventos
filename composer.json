{
    "name": "rafaelsoje/audiovisual",
    "description": "app para estatísticas e controle de eventos",
    "license": "MIT",
    "type": "project",
    "homepage": "https://audiovisual.rafaelsoje.com",    
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7.4",
        "components/font-awesome": "^6.5",
        "components/jquery": "^3.7",
        "datatables/datatables": "^1.10",
        "laminas/laminas-escaper": "^2.17",
        "moment/moment": "^2.30",
        "twbs/bootstrap": "^5.3",
        "twbs/bootstrap-icons": "^1.13"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true,
            "robloach/component-installer": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
