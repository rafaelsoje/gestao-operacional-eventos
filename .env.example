#--------------------------------------------------------------------
# Example Environment Configuration file
#
# Copy this file to `.env` and adjust the values for your environment.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# Em producao, substitua development por production e use HTTPS.
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

# Cookies seguros sao habilitados por padrao.
# Descomente somente para desenvolvimento local por HTTP.
# cookie.secure = false
# Em producao, mantenha cookie.secure = true.

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = audiovisual
database.default.username = root
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

##
# Telegram Bot
##
TELEGRAM_BOT_TOKEN = "CHANGE_ME"
TELEGRAM_CHAT_ID = CHANGE_ME
TELEGRAM_ENABLED = false
# Emails separados por virgula. Vazio significa que nenhum usuario sera silenciado.
TELEGRAM_MUTED_EMAILS = ""
TELEGRAM_ADMIN_EMAIL = "admin@example.com"
SUPERUSER_EMAIL = "admin@example.com"
# Vazio gera uma senha aleatoria por usuario cadastrado pela interface.
# Se preenchido, o valor sera usado literalmente como senha inicial.
# Esta configuracao nao altera as senhas do seeder UsersFromSqlSeeder.
DEFAULT_USER_PASSWORD = ""

##
# Assinatura/licença do sistema
##
SYSTEM_SUBSCRIPTION_ENABLED = false
SYSTEM_SUBSCRIPTION_AMOUNT = 65
SYSTEM_SUBSCRIPTION_WARNING_DAY = 5
SYSTEM_SUBSCRIPTION_DUE_DAY = 10
SYSTEM_SUBSCRIPTION_GRACE_DAYS = 5
# Configuracoes salvas na tela de assinatura prevalecem sobre estes valores.

##
# Asaas
# Produção: https://api.asaas.com/v3
# Sandbox: https://api-sandbox.asaas.com/v3
##
ASAAS_BASE_URL = "https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY = ""
ASAAS_CUSTOMER_ID = ""
# Configure o mesmo token forte no Asaas; recebido no cabecalho asaas-access-token.
# Vazio faz o sistema rejeitar os webhooks.
ASAAS_WEBHOOK_TOKEN = ""
